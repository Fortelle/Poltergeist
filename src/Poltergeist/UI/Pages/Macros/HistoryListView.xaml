<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Poltergeist.UI.Pages.Macros.HistoryListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Poltergeist.UI.Pages.Macros"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Poltergeist.Helpers.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:TimeSpanToHhhmmssConverter x:Key="TimeSpanToHhhmmssConverter"/>
        <local:ConclusionToTextConverter x:Key="ConclusionToTextConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            Margin="{StaticResource ListViewHeaderMargin}"
            Padding="0, 0, 0, 8"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".3*" />
                <ColumnDefinition Width=".2*" />
                <ColumnDefinition Width=".2*" />
                <ColumnDefinition Width=".3*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="/Poltergeist/Macros/HistoryStartTimeTextBlock"
                Grid.Column="0"
                FontWeight="SemiBold"
                TextAlignment="Center"
                />
            <TextBlock
                x:Uid="/Poltergeist/Macros/HistoryDurationTextBlock"
                Grid.Column="1"
                TextAlignment="Center"
                FontWeight="SemiBold"
                />
            <TextBlock
                x:Uid="/Poltergeist/Macros/HistoryResultTextBlock"
                Grid.Column="2"
                TextAlignment="Center"
                FontWeight="SemiBold"
                />
            <TextBlock
                x:Uid="/Poltergeist/Macros/HistoryCommentTextBlock"
                Grid.Column="3"
                TextAlignment="Center"
                FontWeight="SemiBold"
                />
        </Grid>
        <ListView
            Grid.Row="1"
            DoubleTapped="HistoryListView_DoubleTapped"
            ItemsSource="{x:Bind History, Mode=OneWay}"
            Padding="0, 0, 16, 0"
            >
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid
                        Margin="0, 16"
                        >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".3*" />
                            <ColumnDefinition Width=".2*" />
                            <ColumnDefinition Width=".2*" />
                            <ColumnDefinition Width=".3*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            TextAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding StartTime, Mode=OneTime}"
                            />
                        <TextBlock
                            Grid.Column="1"
                            TextAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Duration, Converter={StaticResource TimeSpanToHhhmmssConverter}, Mode=OneTime}"
                            />
                        <TextBlock
                            Grid.Column="2"
                            TextAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Conclusion, Converter={StaticResource ConclusionToTextConverter}, Mode=OneTime}"
                            />
                        <TextBlock
                            Grid.Column="3"
                            TextAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Comment, Mode=OneTime}"
                            />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
