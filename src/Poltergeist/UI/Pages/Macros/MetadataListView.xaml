<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Poltergeist.UI.Pages.Macros.MetadataListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Poltergeist.UI.Pages.Macros"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    >

    <ListView
        ItemsSource="{x:Bind DataContext, Mode=OneWay}"
        Padding="0, 0, 16, 0"
        >
        <ItemsControl.ItemTemplate>
            <DataTemplate
                >
                <Grid 
                    HorizontalAlignment="Stretch"
                    Margin="0, 16"
                    >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="{Binding Key, Mode=OneTime}"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Value, Mode=OneTime}"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding Value, Mode=OneTime}"
                        />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ListView>
</UserControl>
