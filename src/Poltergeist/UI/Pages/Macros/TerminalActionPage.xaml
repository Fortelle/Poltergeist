<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Poltergeist.UI.Pages.Macros.TerminalActionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Poltergeist.UI.Pages.Macros"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:instruments="using:Poltergeist.UI.Controls.Instruments"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:converters="using:Poltergeist.Helpers.Converters"
    xmlns:controls="using:Poltergeist.UI.Controls"
    Style="{StaticResource TabPageStyle}"
    mc:Ignorable="d"
    >

    <Grid
        >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid
            Margin="0, 0, 0, 24"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <controls:IconControl
                Grid.Column="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="32"
                Height="32"
                FontSize="24"
                Icon="{x:Bind ViewModel.Quest.Icon, Mode=OneTime, TargetNullValue=ms-appx:///Poltergeist/Assets/macro_32px.png}"
                />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.Title, Mode=OneTime}"
                Style="{StaticResource Header1Style}"
                Margin="0"
                />

            <CommandBar
                Background="Transparent"
                Grid.Row="0"
                Grid.Column="2"
                DefaultLabelPosition="Right"
                OverflowButtonVisibility="Collapsed"
                HorizontalAlignment="Left"
                IsOpen="False"
                >
                <AppBarButton
                    x:Uid="/Poltergeist/Home/NewInstanceButton"
                    Icon="Play"
                    Command="{x:Bind ViewModel.StartCommand, Mode=OneTime}"
                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource NotConverter}}"
                    Visibility="{x:Bind ViewModel.Quest.AutoExecute, Mode=OneTime, Converter={StaticResource TruthyToCollapsedConverter}}"
                    />
                <AppBarButton
                    x:Uid="/Poltergeist/Home/NewInstanceButton"
                    Icon="Cancel"
                    Command="{x:Bind ViewModel.CancelCommand, Mode=OneTime}"
                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                    />
            </CommandBar>
        </Grid>
        <ScrollViewer
            Grid.Row="1"
            Style="{StaticResource VerticalScrollViewerStyle}"
            VerticalAnchorRatio="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            >
            <ContentPresenter>
                <RichTextBlock
                    x:Name="TextPanelBox"
                    TextWrapping="Wrap"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    >
                <RichTextBlock.Resources>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource VerticalScrollViewerStyle}" />
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0, 8" />
                    </Style>
                </RichTextBlock.Resources>
                </RichTextBlock>
            </ContentPresenter>
        </ScrollViewer>
        
        <StackPanel
            Grid.Row="2"
            >
            <ProgressBar
                HorizontalAlignment="Stretch"
                Maximum="1"
                Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                Margin="0, 16, 0, 8"
                >
            </ProgressBar>
            <TextBlock
                Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                TextAlignment="Center"
                >
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>